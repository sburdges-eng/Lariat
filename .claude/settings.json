{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3:*)",
      "Bash(pip:*)",
      "Bash(pytest:*)",
      "Bash(streamlit:*)",
      "Bash(git:*)",
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(pnpm:*)",
      "Bash(yarn:*)",
      "Bash(next:*)",
      "Bash(gh:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(pwd)",
      "Bash(which:*)",
      "Bash(echo:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(jq:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(diff:*)",
      "Bash(tree:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/seanburdges/lariat_dev/Lariat/scripts/cursor-precommit-gate.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // .tool_response.filePath // empty'); case \"$f\" in *.ts|*.tsx|*.mts|*.cts) ;; *) exit 0;; esac; tsc_out=$(npx tsc --noEmit 2>&1); tsc_exit=$?; lint_out=$(npx eslint --quiet \"$f\" 2>&1); lint_exit=$?; if [ \"$tsc_exit\" != 0 ] || [ \"$lint_exit\" != 0 ]; then { [ \"$tsc_exit\" != 0 ] && printf 'tsc --noEmit failed (exit=%s):\\n%s\\n' \"$tsc_exit\" \"$(printf %s \"$tsc_out\" | tail -20)\"; [ \"$lint_exit\" != 0 ] && printf 'eslint failed (exit=%s):\\n%s\\n' \"$lint_exit\" \"$(printf %s \"$lint_out\" | tail -20)\"; } >&2; exit 2; fi",
            "timeout": 180,
            "statusMessage": "typecheck + lint on edited file"
          }
        ]
      }
    ]
  }
}
